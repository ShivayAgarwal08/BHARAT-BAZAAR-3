# Phase 2: root .env is also supported. Process > server/.env > root .env.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Pooled Neon connection for application queries (retain SSL settings).
DATABASE_URL=
# Direct Neon connection for schema migrations (retain SSL settings).
DATABASE_URL_UNPOOLED=
# Required for real authentication: your own random secret, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional: both values required to seed the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
