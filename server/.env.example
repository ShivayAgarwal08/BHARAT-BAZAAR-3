# Optional in Phase 1: localhost defaults work with no .env file.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Phase 2: pooled Neon connection for application queries (retain SSL settings).
DATABASE_URL=
# Phase 2: direct Neon connection for schema migrations (retain SSL settings).
DATABASE_URL_UNPOOLED=
# Phase 2: supply your own randomly generated secret of at least 32 characters.
# Leave blank in Phase 1; no tokens are issued or verified.
JWT_SECRET=
JWT_EXPIRES_IN=7d
