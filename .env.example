# Server reference. Use root .env or server/.env; never overwrite existing secrets.
# Client public settings belong in client/.env, not here.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=
DATABASE_URL_UNPOOLED=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Both optional values are required to seed the first admin. Never hardcode a password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
